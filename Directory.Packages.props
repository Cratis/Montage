<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.4" />
    <!-- Cratis -->
    <!-- Keep the public Cratis / Arc family aligned so generated self-bindings and runtime contracts
         are built against the same Chronicle contract generation. -->
    <PackageVersion Include="Cratis" Version="22.51.0" />
    <PackageVersion Include="Cratis.Arc" Version="22.51.0" />
    <PackageVersion Include="Cratis.Arc.MongoDB" Version="22.51.0" />
    <PackageVersion Include="Cratis.Arc.ProxyGenerator.Build" Version="22.51.0" />
    <PackageVersion Include="Cratis.Arc.Swagger" Version="22.51.0" />
    <!-- Keep Chronicle clients and the Aspire hosting integration on the same release; the AppHost
         pins the Chronicle kernel image to this same version (Source/Composition/Program.cs). -->
    <PackageVersion Include="Cratis.Chronicle" Version="19.33.3" />
    <PackageVersion Include="Cratis.Chronicle.Aspire" Version="19.33.3" />
    <!-- Analyzers, pinned by the root Directory.Build.props for every project. -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.259" />
    <PackageVersion Include="Microsoft.Net.Compilers.Toolset" Version="5.9.0" />
  </ItemGroup>
</Project>
